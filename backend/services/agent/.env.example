PORT=8003

# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cortexai?retryWrites=true&w=majority

# Internal Microservices URLs
CHAT_SERVICE=http://localhost:8002
AUTH_SERVICE=http://localhost:8001
REDIS_URL=redis://localhost:6379

# AI & LLM API Keys
# Groq Console: https://console.groq.com/keys (used for chat, search, ppt, pdf)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Google AI Studio: https://aistudio.google.com/app/apikey (used for image analyzer, embeddings)
GOOGLE_API_KEY=AIzaSy_your_google_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# OpenRouter: https://openrouter.ai/keys (used for coding agent - deepseek)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
OPENROUTER_MODEL=deepseek/deepseek-chat

# Tavily AI: https://tavily.com (used for real-time web search agent)
TAVILY_API_KEY=tvly-your_tavily_api_key

# AWS S3 Storage (for PPT, PDF, and generated image uploads)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_KEY=your_aws_secret_access_key
AWS_BUCKET_NAME=your_s3_bucket_name

# Qdrant Vector Database (https://cloud.qdrant.io - used for PDF RAG agent)
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
